# Shared secret for logging into the UI and for uploads from the iOS Shortcut.
# Generate one with: openssl rand -hex 32
APP_TOKEN=change-me

DATA_DIR=/data
PORT=3000
TZ=Europe/Paris

# Docker only: owner (user and group id) given to the data folder; the server runs as this user.
# Check yours with: id -u && id -g
PUID=1000
PGID=1000
